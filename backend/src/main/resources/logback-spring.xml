<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- Máscara de PII e segredos (T1.5): %maskedMsg e %maskedEx substituem %msg e o stack trace. -->
    <conversionRule conversionWord="maskedMsg" converterClass="com.astro.leadflow.shared.config.PiiMaskingConverter" />
    <conversionRule conversionWord="maskedEx" converterClass="com.astro.leadflow.shared.config.PiiMaskingThrowableConverter" />

    <!-- ── Console appender (dev/default) ─────────────────────────────────── -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} [%thread] %-5level %logger{36} [%X{correlationId:-}] [%X{orgId:-}] - %maskedMsg%n%maskedEx</pattern>
        </encoder>
    </appender>

    <appender name="DB_ERROR" class="com.astro.leadflow.shared.modules.monitoring.error.DatabaseErrorAppender" />
    <appender name="ASYNC_DB_ERROR" class="ch.qos.logback.classic.AsyncAppender">
        <appender-ref ref="DB_ERROR" />
    </appender>

    <!-- ── JSON appender (prod) ───────────────────────────────────────────
         Para ativar:
         1. Remova o comentário do appender abaixo
         2. Adicione a dependência no build.gradle.kts:
            implementation("net.logstash.logback:logstash-logback-encoder:7.4")
         3. Use com profile "prod"

    <springProfile name="prod">
        <appender name="JSON" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                <includeMdcKeyName>correlationId</includeMdcKeyName>
                <includeMdcKeyName>orgId</includeMdcKeyName>
            </encoder>
        </appender>

        <root level="INFO">
            <appender-ref ref="JSON" />
        </root>
    </springProfile>
    ──────────────────────────────────────────────────────────────────────── -->

    <springProfile name="!prod">
        <root level="INFO">
            <appender-ref ref="CONSOLE" />
            <appender-ref ref="ASYNC_DB_ERROR" />
        </root>
        <logger name="com.astro.leadflow" level="DEBUG" additivity="false">
            <appender-ref ref="CONSOLE" />
        </logger>
    </springProfile>

    <!-- Perfil prod: SEM este bloco o root logger fica sem appender e nada do Spring/Hibernate/Flyway
         (inclusive erros fatais de boot) chega ao stdout do container. com.astro.leadflow herda os
         appenders do root (additivity padrao) e fica em INFO. -->
    <springProfile name="prod">
        <root level="INFO">
            <appender-ref ref="CONSOLE" />
            <appender-ref ref="ASYNC_DB_ERROR" />
        </root>
        <logger name="com.astro.leadflow" level="INFO" />
    </springProfile>

</configuration>
