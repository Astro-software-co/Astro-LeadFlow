# Copie para infra/aws/config.env (esta cópia local NÃO é commitada) e ajuste.
GH_REPO=Astro-software-co/Astro-LeadFlow   # exatamente como aparece no GitHub (maiúsculas importam no OIDC)
AWS_REGION=us-east-1
ENVNAME=staging
BUDGET_EMAIL=voce@exemplo.com               # recebe os alertas de custo
BUDGET_LIMIT_USD=100
INSTANCE_TYPE=t3.medium                     # 4 GB: backend JVM + Postgres + Redis + nginx + Caddy
ROOT_VOLUME_GB=30
BACKUP_RETENTION_DAYS=30
# Deixe vazio enquanto não houver domínio: usa <ip>.sslip.io. Com domínio: app.seudominio.com.br
DOMAIN=
# Se já tiver um perfil do AWS CLI, informe aqui (ex.: leadflow-admin). Vazio = credenciais do ambiente.
AWS_PROFILE=
