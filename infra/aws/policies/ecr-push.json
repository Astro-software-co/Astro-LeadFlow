{
  "Version": "2012-10-17",
  "Statement": [
    { "Sid": "Auth", "Effect": "Allow", "Action": "ecr:GetAuthorizationToken", "Resource": "*" },
    { "Sid": "Push", "Effect": "Allow",
      "Action": [
        "ecr:BatchCheckLayerAvailability", "ecr:InitiateLayerUpload", "ecr:UploadLayerPart",
        "ecr:CompleteLayerUpload", "ecr:PutImage", "ecr:BatchGetImage", "ecr:GetDownloadUrlForLayer",
        "ecr:DescribeImages", "ecr:DescribeRepositories"
      ],
      "Resource": [
        "arn:aws:ecr:__REGION__:__ACCOUNT_ID__:repository/astro-leadflow-backend",
        "arn:aws:ecr:__REGION__:__ACCOUNT_ID__:repository/astro-leadflow-frontend"
      ] }
  ]
}
