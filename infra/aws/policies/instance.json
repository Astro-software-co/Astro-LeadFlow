{
  "Version": "2012-10-17",
  "Statement": [
    { "Sid": "EcrAuth", "Effect": "Allow", "Action": "ecr:GetAuthorizationToken", "Resource": "*" },
    { "Sid": "EcrPull", "Effect": "Allow",
      "Action": [ "ecr:BatchCheckLayerAvailability", "ecr:BatchGetImage", "ecr:GetDownloadUrlForLayer" ],
      "Resource": [
        "arn:aws:ecr:__REGION__:__ACCOUNT_ID__:repository/astro-leadflow-backend",
        "arn:aws:ecr:__REGION__:__ACCOUNT_ID__:repository/astro-leadflow-frontend"
      ] },
    { "Sid": "ReadParams", "Effect": "Allow",
      "Action": [ "ssm:GetParametersByPath", "ssm:GetParameters", "ssm:GetParameter" ],
      "Resource": "arn:aws:ssm:__REGION__:__ACCOUNT_ID__:parameter/__PROJECT__/__ENV__*" },
    { "Sid": "DecryptParams", "Effect": "Allow", "Action": "kms:Decrypt", "Resource": "*",
      "Condition": { "StringEquals": { "kms:ViaService": "ssm.__REGION__.amazonaws.com" } } },
    { "Sid": "ReadBundle", "Effect": "Allow", "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::__BUCKET__/artifacts/*" },
    { "Sid": "Backups", "Effect": "Allow", "Action": [ "s3:PutObject", "s3:GetObject" ],
      "Resource": "arn:aws:s3:::__BUCKET__/backups/*" },
    { "Sid": "ListBucket", "Effect": "Allow", "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::__BUCKET__" }
  ]
}
