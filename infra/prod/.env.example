# Copie para .env na EC2 (nunca commitar o .env). Idealmente gerado a partir do SSM Parameter Store.

# --- compose ---
DOMAIN=app.exemplo.com.br
IMAGE_REGISTRY=ghcr.io/astro-software-co
IMAGE_TAG=main
REDIS_PASSWORD=
# so com --profile local-db
POSTGRES_DB=leadflow
POSTGRES_USER=leadflow
POSTGRES_PASSWORD=

# --- Spring (application-prod.yml exige estas vars: sem default, o startup falha se faltar) ---
SPRING_PROFILES_ACTIVE=prod
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/leadflow
SPRING_DATASOURCE_USERNAME=leadflow
SPRING_DATASOURCE_PASSWORD=
SPRING_DATA_REDIS_HOST=redis
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587

# --- URLs / CORS / auth ---
APP_BASE_URL=https://app.exemplo.com.br
PUBLIC_API_URL=https://app.exemplo.com.br
APP_CORS_ALLOWED_ORIGINS=https://app.exemplo.com.br
AUTH_REFRESH_COOKIE_SECURE=true
AUTH_REFRESH_COOKIE_SAME_SITE=Lax
JWT_SECRET=
JWT_EXPIRATION_MS=300000
JWT_REFRESH_MS=604800000
RATE_LIMIT_ENABLED=true

# --- Meta / WhatsApp (mock ate a conta Meta estar validada) ---
META_API_MODE=mock
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_APP_SECRET=   # obrigatorio em prod mesmo com META_API_MODE=mock (fail-fast do filtro de webhook)
META_VERIFY_TOKEN=

# --- Abacate Pay ---
ABACATEPAY_API_URL=https://api.abacatepay.com/v2
ABACATEPAY_API_KEY=
ABACATEPAY_WEBHOOK_SECRET=
# ABACATEPAY_WEBHOOK_PUBLIC_KEY tem default no application.yaml

# --- Marketplaces ---
MARKETPLACE_WEBHOOK_TOKEN=
WEBMOTORS_CLIENT_ID=
WEBMOTORS_CLIENT_SECRET=
ML_APP_ID=
ML_CLIENT_SECRET=
ML_REDIRECT_URI=https://app.exemplo.com.br/api/v1/auth/mercadolivre/callback
MARKETPLACE_RECONCILIATION_CRON=0 0 3 * * *

# --- Chatbot / AWS (mock e AWS desligada ate a fase do Lex) ---
CHATBOT_ENGINE_MODE=mock
APP_AWS_ENABLED=false
AWS_REGION=us-east-1
AWS_S3_BUCKET=
AWS_SQS_LEAD_QUEUE=
AWS_SQS_MARKETPLACE_QUEUE=
AWS_LEX_BOT_ID=
AWS_LEX_BOT_ALIAS_ID=
AWS_LEX_LOCALE_ID=pt_BR
AWS_BEDROCK_MODEL_ID=
# Sem AWS_ACCESS_KEY_ID/SECRET em producao: usar instance profile da EC2.

# --- Planos ---
DEFAULT_PLAN=free
TRIAL_DAYS=14
